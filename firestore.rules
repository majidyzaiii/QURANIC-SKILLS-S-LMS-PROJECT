// Firestore Security Rules — Quranic Skills LMS
// Paste the whole file into Firebase Console -> Firestore Database -> Rules -> Publish.
// Requires Firebase Authentication for EVERY read and write (single admin for now;
// roles for Teacher/Manager/Parent come later). Until these rules are published,
// the database is still in test mode (open) and the login screen is UI-only.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
